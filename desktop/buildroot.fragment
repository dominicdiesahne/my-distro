# Our changes on top of Buildroot's qemu_x86_64_defconfig.

# Prebuilt glibc cross-compiler from Bootlin (saves building GCC ourselves)
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN_X86_64_GLIBC_STABLE=y

# System
BR2_TARGET_GENERIC_HOSTNAME="my-distro"
BR2_TARGET_GENERIC_ISSUE="Welcome to my-distro"
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_MY_DISTRO_PATH)/overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="board/qemu/x86_64/post-build.sh $(BR2_EXTERNAL_MY_DISTRO_PATH)/post-build.sh"
# Inside each image, with the final owners: the factory-reset copy
BR2_ROOTFS_POST_FAKEROOT_SCRIPT="$(BR2_EXTERNAL_MY_DISTRO_PATH)/post-fakeroot.sh"
# (the disk image for make run-desktop; 2G since 0.9.5 brought 3D graphics,
# printing and Bluetooth)
BR2_TARGET_ROOTFS_EXT2_SIZE="2G"
BR2_PACKAGE_MY_INIT=y

# Users and passwords: root (password "root") and dominic (see users.table).
# The graphical login screen is our own program (login/my-login.c); it
# checks passwords with libxcrypt.
BR2_TARGET_GENERIC_ROOT_PASSWD="root"
BR2_ROOTFS_USERS_TABLES="$(BR2_EXTERNAL_MY_DISTRO_PATH)/users.table"
BR2_PACKAGE_MY_LOGIN=y
BR2_PACKAGE_LIBXCRYPT=y

# File history: every changed file is versioned (history/, kernel: fanotify)
BR2_PACKAGE_MY_HISTORY=y

# Semantic file search: llama.cpp runs the embedding model all-MiniLM-L6-v2
BR2_PACKAGE_LLAMA_CPP=y
BR2_PACKAGE_MY_SEARCH=y
BR2_PACKAGE_MY_SEARCH_MODEL=y
BR2_TARGET_TZ_INFO=y
BR2_TARGET_LOCALTIME="Europe/Vienna"

# UTF-8 locale and glibc's character converters. Without them Openbox can't
# decode window titles and shows every window as "Unnamed Window".
# (0.9.7: French, Spanish, Italian, Turkish, Polish and Romanian, see the end)
BR2_GENERATE_LOCALE="en_US.UTF-8 de_DE.UTF-8 de_AT.UTF-8 fr_FR.UTF-8 es_ES.UTF-8 it_IT.UTF-8 tr_TR.UTF-8 pl_PL.UTF-8 ro_RO.UTF-8"
BR2_TOOLCHAIN_GLIBC_GCONV_LIBS_COPY=y
# Keep Xlib's UTF-8 locale too (its folder is called en_US.UTF-8); without it
# X programs like xterm fall back to plain ASCII and show icons as garbage.
# (0.9.5: German added, see the end of this file)
BR2_ENABLE_LOCALE_WHITELIST="C en_US en_US.UTF-8 de de_DE de_DE.UTF-8 de_AT de_AT.UTF-8 fr fr_FR fr_FR.UTF-8 es es_ES es_ES.UTF-8 it it_IT it_IT.UTF-8 tr tr_TR tr_TR.UTF-8 pl pl_PL pl_PL.UTF-8 ro ro_RO ro_RO.UTF-8 locale.alias locale.dir compose.dir"

# Bootable ISO (images/rootfs.iso9660): GRUB for BIOS and UEFI, the whole
# root filesystem is loaded into RAM as an initrd (a live system)
BR2_TARGET_GRUB2=y
BR2_TARGET_GRUB2_I386_PC=y
BR2_TARGET_GRUB2_X86_64_EFI=y
BR2_TARGET_GRUB2_BOOT_PARTITION="cd"
BR2_TARGET_GRUB2_BUILTIN_MODULES_PC="boot linux normal iso9660 biosdisk part_msdos part_gpt all_video"
BR2_TARGET_GRUB2_BUILTIN_MODULES_EFI="boot linux normal iso9660 fat part_msdos part_gpt efi_gop all_video search search_fs_file"
BR2_TARGET_GRUB2_BUILTIN_CONFIG_EFI="$(BR2_EXTERNAL_MY_DISTRO_PATH)/grub-efi-embedded.cfg"
BR2_TARGET_ROOTFS_ISO9660=y
BR2_TARGET_ROOTFS_ISO9660_GRUB2=y
BR2_TARGET_ROOTFS_ISO9660_BOOT_MENU="$(BR2_EXTERNAL_MY_DISTRO_PATH)/grub.cfg"
BR2_TARGET_ROOTFS_ISO9660_INITRD=y
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_CPIO_GZIP=y
# The update package for installed systems (my-update): the root filesystem
# as a tar.xz, next to the ISO in every release
BR2_TARGET_ROOTFS_TAR=y
BR2_TARGET_ROOTFS_TAR_XZ=y
# Firmware for real PCs: Intel and AMD graphics, Realtek network cards (the
# drivers are in linux-gui.fragment)
BR2_PACKAGE_LINUX_FIRMWARE=y
BR2_PACKAGE_LINUX_FIRMWARE_I915=y
BR2_PACKAGE_LINUX_FIRMWARE_XE=y
BR2_PACKAGE_LINUX_FIRMWARE_AMDGPU=y
BR2_PACKAGE_LINUX_FIRMWARE_RADEON=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_8169=y
# Wi-Fi: firmware of the chips in linux-gui.fragment, the radio rules per
# country (wireless-regdb), wpa_supplicant (connects, WPA2 and WPA3), its
# command-line tool wpa_cli (the Wi-Fi window uses it) and iw
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_7260=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_7265D=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_8000C=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_8265=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_9XXX=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_22000=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_QUZ=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_6E=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_7=y
BR2_PACKAGE_LINUX_FIRMWARE_ATHEROS_9271=y
BR2_PACKAGE_LINUX_FIRMWARE_ATHEROS_10K_QCA9377=y
BR2_PACKAGE_LINUX_FIRMWARE_ATHEROS_11K_WCN6855=y
BR2_PACKAGE_LINUX_FIRMWARE_MEDIATEK_MT7601U=y
BR2_PACKAGE_LINUX_FIRMWARE_MEDIATEK_MT7921=y
BR2_PACKAGE_LINUX_FIRMWARE_MEDIATEK_MT7922=y
BR2_PACKAGE_LINUX_FIRMWARE_MEDIATEK_MT7925=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_87XX=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_88XX=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_RTW88=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_RTW89=y
BR2_PACKAGE_LINUX_FIRMWARE_BRCM_BCM43XX=y
BR2_PACKAGE_LINUX_FIRMWARE_BRCM_BCM43XXX=y
BR2_PACKAGE_WIRELESS_REGDB=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_WPA_SUPPLICANT_CTRL_IFACE=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_WPA_SUPPLICANT_WPA3=y
BR2_PACKAGE_WPA_SUPPLICANT_AUTOSCAN=y
# access point mode: lets a test (or you) make a Wi-Fi network (mode=2)
BR2_PACKAGE_WPA_SUPPLICANT_AP_SUPPORT=y
BR2_PACKAGE_IW=y
# The openssl command: my-update checks the update's signature with it
BR2_PACKAGE_LIBOPENSSL_BIN=y

# Installer (desktop/overlay/usr/sbin/my-install): copies the live system onto
# a disk. It needs the kernel inside the root filesystem (/boot/bzImage),
# GRUB's grub-install with its BIOS and UEFI modules, and tools to make
# partitions (sfdisk) and filesystems (ext4, FAT for the EFI partition).
BR2_LINUX_KERNEL_INSTALL_TARGET=y
BR2_TARGET_GRUB2_INSTALL_TOOLS=y
BR2_PACKAGE_UTIL_LINUX_BINARIES=y
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_DOSFSTOOLS=y
BR2_PACKAGE_DOSFSTOOLS_MKFS_FAT=y

# Kernel: add graphics, mouse and USB on top of the QEMU kernel config
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_MY_DISTRO_PATH)/linux-gui.fragment"

# X11 display server
BR2_PACKAGE_XORG7=y
BR2_PACKAGE_XSERVER_XORG_SERVER=y
BR2_PACKAGE_XSERVER_XORG_SERVER_MODULAR=y
BR2_PACKAGE_XDRIVER_XF86_INPUT_LIBINPUT=y
BR2_PACKAGE_XDRIVER_XF86_VIDEO_FBDEV=y
BR2_PACKAGE_XAPP_XINIT=y
BR2_PACKAGE_XAPP_XRDB=y
# setxkbmap: the setup changes the keyboard layout of the running X server
BR2_PACKAGE_XAPP_SETXKBMAP=y
BR2_PACKAGE_XAPP_XSETROOT=y

# Desktop: window manager, terminal, small apps, fonts
BR2_PACKAGE_OPENBOX=y
BR2_PACKAGE_XTERM=y
BR2_PACKAGE_XAPP_XCLOCK=y
BR2_PACKAGE_XAPP_XEYES=y
BR2_PACKAGE_XAPP_XCALC=y
BR2_PACKAGE_DEJAVU=y
BR2_PACKAGE_XFONT_FONT_MISC_MISC=y
BR2_PACKAGE_XFONT_FONT_CURSOR_MISC=y

# Taskbar: our own program (panel/my-panel.c), drawn with Xft for smooth text
BR2_PACKAGE_MY_PANEL=y

# Settings app and Clock app (settings/), drawn with GTK 3 and cairo
BR2_PACKAGE_MY_SETTINGS=y
BR2_PACKAGE_XLIB_LIBXFT=y
BR2_PACKAGE_IMLIB2=y
BR2_PACKAGE_IMLIB2_X=y
BR2_PACKAGE_IMLIB2_PNG=y
# JPEG pictures too (wallpapers; the image viewer feh from the Software app)
BR2_PACKAGE_IMLIB2_JPEG=y

# File manager with desktop icons (PCManFM, a GTK 3 app). GTK on X11 needs
# an OpenGL library: Mesa. Its drivers for real graphics cards (3D) are in
# the 0.9.5 part below; until 0.9.4 it only had the slow software renderer
# softpipe.
BR2_PACKAGE_MESA3D=y
# BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_SOFTPIPE is not set
BR2_PACKAGE_MESA3D_OPENGL_GLX=y
BR2_PACKAGE_PCMANFM=y
BR2_PACKAGE_ADWAITA_ICON_THEME=y
BR2_PACKAGE_HICOLOR_ICON_THEME=y
BR2_PACKAGE_SHARED_MIME_INFO=y

# Web browser: NetSurf with its GTK 3 window, curl + OpenSSL for HTTPS,
# and the root certificates that HTTPS needs to trust websites
BR2_PACKAGE_NETSURF=y
BR2_PACKAGE_NETSURF_GTK3=y
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_CA_CERTIFICATES=y

# Terminal tools: text editor and system monitor
BR2_PACKAGE_NANO=y
BR2_PACKAGE_HTOP=y

# IDE: Neovim with LazyVim (desktop/package/my-ide, config in desktop/lazyvim).
# It brings git, ripgrep and fd. wget and unzip are for Mason (:Mason),
# which downloads language servers when you are online.
BR2_PACKAGE_MY_IDE=y
BR2_PACKAGE_WGET=y
BR2_PACKAGE_UNZIP=y

# Python 3 to run .py scripts, with pip, the interactive prompt's line
# editing, SQLite, compression and the ssl module pip needs for HTTPS
BR2_PACKAGE_PYTHON3=y
BR2_PACKAGE_PYTHON3_PYC_ONLY=y
BR2_PACKAGE_PYTHON3_READLINE=y
BR2_PACKAGE_PYTHON3_SSL=y
BR2_PACKAGE_PYTHON3_SQLITE=y
BR2_PACKAGE_PYTHON3_ZLIB=y
BR2_PACKAGE_PYTHON3_BZIP2=y
BR2_PACKAGE_PYTHON3_XZ=y
BR2_PACKAGE_PYTHON_PIP=y

# --- 0.9.2 -------------------------------------------------------------------

# BusyBox with ntpd (the time from the internet, /etc/init.d/S48time)
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_MY_DISTRO_PATH)/busybox.fragment"

# Sound: ALSA's tools. amixer (my-volume and the taskbar's speaker set the
# volume with the same controls), alsamixer (all controls, in a terminal),
# alsactl (good start values at boot), aplay and speaker-test to try it.
BR2_PACKAGE_ALSA_LIB=y
BR2_PACKAGE_ALSA_LIB_MIXER=y
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_ALSACTL=y
BR2_PACKAGE_ALSA_UTILS_ALSAMIXER=y
BR2_PACKAGE_ALSA_UTILS_AMIXER=y
BR2_PACKAGE_ALSA_UTILS_APLAY=y
BR2_PACKAGE_ALSA_UTILS_SPEAKER_TEST=y

# Firewall: the nft command loads /etc/nftables.conf (kernel part in
# linux-gui.fragment)
BR2_PACKAGE_NFTABLES=y

# sudo: members of the group wheel may run commands as root with their own
# password (/etc/sudoers.d/wheel)
BR2_PACKAGE_SUDO=y

# --- 0.9.3 -------------------------------------------------------------------

# Display settings (Settings app, Display page) set the screens with xrandr
BR2_PACKAGE_XAPP_XRANDR=y

# The screen lock (login/my-lock.c) asks the X server how long nobody has
# touched keyboard or mouse: the screen saver extension's library
BR2_PACKAGE_XLIB_LIBXSCRNSAVER=y

# Media player: mpv (videos and music, FFmpeg for the formats). LuaJIT gives
# it its on-screen controls (play/pause, seek bar, volume).
BR2_PACKAGE_LUAJIT=y
BR2_PACKAGE_MPV=y

# --- 0.9.4 -------------------------------------------------------------------

# Wi-Fi with a user name and password (eduroam and other WPA2/WPA3
# Enterprise networks): wpa_supplicant's EAP methods (PEAP, TTLS, ...)
BR2_PACKAGE_WPA_SUPPLICANT_EAP=y

# VPN: the wg tool sets up WireGuard tunnels (kernel part in linux-gui.fragment).
# iproute2's ip command, because BusyBox's ip can't make a WireGuard interface.
BR2_PACKAGE_WIREGUARD_TOOLS=y
BR2_PACKAGE_IPROUTE2=y

# Screen recording (my-record): FFmpeg reads the screen over XCB. Webcams
# (my-camera) come in through FFmpeg's video4linux input, which is in already.
BR2_PACKAGE_FFMPEG_XCBGRAB=y

# --- 0.9.5 -------------------------------------------------------------------

# Bluetooth: BlueZ's daemon bluetoothd (/etc/init.d/S40bluetoothd) and its
# terminal tool bluetoothctl. Plugins for headphones and speakers (A2DP),
# keyboards and mice (HID, and the Bluetooth Low Energy ones: HoG). The
# Bluetooth window (settings/my-bluetooth.c) talks to bluetoothd over D-Bus.
# Kernel drivers: linux-gui.fragment.
BR2_PACKAGE_BLUEZ5_UTILS=y
BR2_PACKAGE_BLUEZ5_UTILS_CLIENT=y
BR2_PACKAGE_BLUEZ5_UTILS_PLUGINS_AUDIO=y
BR2_PACKAGE_BLUEZ5_UTILS_PLUGINS_HID=y
BR2_PACKAGE_BLUEZ5_UTILS_PLUGINS_HOG=y
# (Sound to Bluetooth headphones went through bluez-alsa until 0.9.6; since
# 0.9.7 PipeWire does it, see the end of this file.)
# Firmware of the Bluetooth chips (most come together with a Wi-Fi chip):
# Intel, Realtek, MediaTek, Qualcomm. Broadcom's is not in linux-firmware;
# their chips work without it, with the firmware they start with.
BR2_PACKAGE_LINUX_FIRMWARE_IBT=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_87XX_BT=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_88XX_BT=y
BR2_PACKAGE_LINUX_FIRMWARE_MEDIATEK_MT7921_BT=y
BR2_PACKAGE_LINUX_FIRMWARE_MEDIATEK_MT7922_BT=y
BR2_PACKAGE_LINUX_FIRMWARE_MEDIATEK_MT7925_BT=y
BR2_PACKAGE_LINUX_FIRMWARE_QUALCOMM_6174A_BT=y
BR2_PACKAGE_LINUX_FIRMWARE_QUALCOMM_9377_BT=y

# Printing: CUPS (/etc/init.d/S81cupsd, only reachable from this computer:
# /etc/cups/cupsd.conf) with cups-filters, which turn documents into what
# the printer understands. Printers made in the last ~10 years need no
# driver ("driverless", IPP Everywhere / AirPrint); for older ones there are
# Gutenprint (many Canon, Epson, ... inkjets) and HPLIP (HP). Ghostscript
# renders PDF and PostScript for printers that want pictures (raster).
BR2_PACKAGE_CUPS=y
BR2_PACKAGE_CUPS_FILTERS=y
BR2_PACKAGE_GHOSTSCRIPT=y
BR2_PACKAGE_GUTENPRINT=y
BR2_PACKAGE_HPLIP=y
BR2_PACKAGE_LIBUSB=y
# Finding printers and scanners in the network: Avahi (mDNS / DNS-SD), and
# printer.local names in addresses (nss-mdns). It only looks; it doesn't
# announce this computer (/etc/avahi/avahi-daemon.conf).
BR2_PACKAGE_AVAHI=y
BR2_PACKAGE_AVAHI_DAEMON=y
BR2_PACKAGE_NSS_MDNS=y
# Scanning: SANE with its drivers, and sane-airscan for network scanners and
# printers with a scanner (driverless, eSCL/WSD). The Printers window has a
# "Scan" button (scanimage).
BR2_PACKAGE_SANE_BACKENDS=y
BR2_PACKAGE_SANE_AIRSCAN=y

# 3D graphics: Mesa with drivers for real graphics chips instead of only the
# software renderer. LLVM compiles the shaders (llvmpipe, radeonsi).
#   radeonsi (AMD since 2012), r600 (older AMD), virgl (QEMU with
#   virtio-vga-gl), svga (VMware, and VirtualBox with VMSVGA), llvmpipe (any
#   other computer, on the CPU; fast enough for the desktop and simple games)
# Vulkan: radv (AMD). EGL and GBM let Xorg's modesetting driver draw with
# the graphics chip (glamor, needs libepoxy).
# Not yet: Intel's iris, crocus and anv. Mesa 26 compiles parts of them with
# its OpenCL compiler, so they need clang and libclc (on the build machine
# and in the image): hours more building, several GB more disk and a bigger
# image. Intel graphics use llvmpipe for 3D until then.
BR2_PACKAGE_MESA3D_LLVM=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_LLVMPIPE=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_RADEONSI=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_R600=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_VIRGL=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_SVGA=y
BR2_PACKAGE_MESA3D_VULKAN_DRIVER_AMD=y
# libvulkan.so, which Vulkan programs load; it finds the drivers above
BR2_PACKAGE_VULKAN_LOADER=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y
BR2_PACKAGE_LIBEPOXY=y
# glxinfo and glxgears: which renderer is used, and a quick test
BR2_PACKAGE_MESA3D_DEMOS=y

# Disks window (settings/my-disks.c): makes and checks filesystems. ext4
# (e2fsprogs) and FAT (dosfstools) were in already; now also their checkers,
# exFAT and NTFS (mkntfs, ntfsfix).
BR2_PACKAGE_DOSFSTOOLS_FSCK_FAT=y
BR2_PACKAGE_DOSFSTOOLS_FATLABEL=y
BR2_PACKAGE_EXFATPROGS=y
BR2_PACKAGE_NTFS_3G=y
BR2_PACKAGE_NTFS_3G_NTFSPROGS=y

# Backup (my-backup): rsync copies only what changed, and hard-links the
# rest to the last backup (each backup looks complete, but costs little room)
BR2_PACKAGE_RSYNC=y

# Accessibility: an on-screen keyboard (xvkbd; Start menu and login screen)
# and a voice that reads text aloud (eSpeak; my-speak plays it with aplay)
BR2_PACKAGE_XVKBD=y
BR2_PACKAGE_ESPEAK=y
BR2_PACKAGE_ESPEAK_AUDIO_BACKEND_NONE=y

# --- 0.9.6 -------------------------------------------------------------------

# Fonts for more of the world's writing: Chinese, Japanese and Korean
# (WenQuanYi Zen Hei, one file for all three) and colour emoji (Noto Color
# Emoji, desktop/package/my-emoji-font). DejaVu covers Latin, Greek and
# Cyrillic; fontconfig takes the others for the characters it lacks.
BR2_PACKAGE_WQY_ZENHEI=y
BR2_PACKAGE_MY_EMOJI_FONT=y

# Full-disk encryption in the installer (my-install): cryptsetup makes and
# opens LUKS2 volumes (kernel part, dm-crypt, in linux-gui.fragment). kbd's
# keymaps and loadkeys give the passphrase prompt at the start the desktop's
# keyboard layout (my-mkinitramfs).
BR2_PACKAGE_CRYPTSETUP=y
BR2_PACKAGE_KBD=y

# Developer tools: the debugger, system call and library call tracers, and
# perf (CPU profiling with the kernel's performance counters)
BR2_PACKAGE_GDB=y
BR2_PACKAGE_GDB_DEBUGGER=y
BR2_PACKAGE_STRACE=y
BR2_PACKAGE_LTRACE=y
BR2_PACKAGE_LINUX_TOOLS_PERF=y

# Sandboxing: bubblewrap runs a program in its own namespaces with only the
# files it needs (my-sandbox). The audit daemon writes what the kernel's
# audit system reports (logins, changes to passwords and sudo rules) to
# /var/lib/audit/audit.log.
BR2_PACKAGE_BUBBLEWRAP=y
BR2_PACKAGE_AUDIT=y

# Semantic search reads the text of PDFs with pdftotext (poppler)
BR2_PACKAGE_POPPLER=y
BR2_PACKAGE_POPPLER_UTILS=y

# Windows shares (SMB/CIFS): mount.cifs, used by my-share
BR2_PACKAGE_CIFS_UTILS=y

# Languages: translations (gettext) for all programs that have them (GTK,
# the file manager, ...), and msgfmt on the build machine for my-distro's
# own translations (po/). The German locales and the whitelist that keeps
# German next to English are further up.
BR2_SYSTEM_ENABLE_NLS=y
BR2_PACKAGE_MY_LOCALE=y

# --- 0.9.7 -------------------------------------------------------------------

# Sound server: PipeWire with its session manager WirePlumber, started in
# every session (/usr/lib/my-distro/autostart). ALSA programs play through
# it (pipewire-alsa makes it ALSA's "default"), PulseAudio programs too
# (pipewire-pulse), and its Bluetooth part replaces bluez-alsa: headphones
# get the sound of programs that are already playing, and the Sound window
# (my-sound) moves programs between outputs and sets a volume per program.
# WirePlumber needs Lua 5.3/5.4, but the image has LuaJIT (5.1, mpv's
# on-screen controls) and Buildroot allows only one Lua: my-wireplumber is
# Buildroot's WirePlumber with its own copy of Lua 5.4 built in
# (desktop/package/my-wireplumber, my-lua54).
BR2_PACKAGE_PIPEWIRE=y
BR2_PACKAGE_MY_WIREPLUMBER=y

# 3D on Intel graphics: Mesa's iris (Intel since 2015, Broadwell), crocus
# (2006-2014) and i915 (older still), and the Vulkan driver anv. Mesa
# compiles some of their shaders while it is built, with its OpenCL
# compiler on the build machine (host clang and libclc): only the build
# gets bigger, the image just gets the drivers.
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_IRIS=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_CROCUS=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_I915=y
BR2_PACKAGE_MESA3D_VULKAN_DRIVER_INTEL=y

# Videos: AV1 with dav1d (FFmpeg has H.264, H.265 and VP9 itself), and
# decoding with the graphics chip (VA-API): Mesa's driver for AMD
# (radeonsi) and Intel's older driver (i965, up to ~2019's chips). mpv
# uses it when it works (hwdec=auto-safe in /etc/mpv/mpv.conf).
BR2_PACKAGE_DAV1D=y
BR2_PACKAGE_LIBVA=y
BR2_PACKAGE_LIBVA_UTILS=y
BR2_PACKAGE_MESA3D_GALLIUM_VA=y
BR2_PACKAGE_LIBVA_INTEL_DRIVER=y

# Firmware updates: fwupd (fwupdmgr) asks the LVFS (fwupd.org) for new
# firmware of this computer's parts; UEFI capsules go through fwupd-efi.
# The System update window shows them and asks before applying one.
BR2_PACKAGE_FWUPD=y
BR2_PACKAGE_FWUPD_EFI=y
# LVFS metadata comes as .xz, firmware as cabinet files (libarchive),
# signatures are checked with GnuTLS
BR2_PACKAGE_LIBARCHIVE=y

# Secure Boot: Debian's Microsoft-signed shim and MokManager, GRUB and the
# kernel signed with my-distro's own key (desktop/package/my-secureboot,
# make desktop-secureboot), mokutil to enroll that key once
BR2_PACKAGE_MY_SECUREBOOT=y
BR2_PACKAGE_MOKUTIL=y

# Screen reader (my-reader, panel/my-reader.c): speaks what has the focus
# in GTK programs through AT-SPI (at-spi2-core, in the image already for
# GTK) and eSpeak. Nothing new to build.

# Docker (a Software app package) needs runc, whose containerd wants
# util-linux's pivot_root: util-linux is in the image, so its option has
# to be here (make packages may not change the image's packages)
BR2_PACKAGE_UTIL_LINUX_PIVOT_ROOT=y

# util-linux's mount and mountpoint: the Docker packages (containerd) select
# them, and make packages must not change the image's options, so they are in
# the image (a few hundred KB).
