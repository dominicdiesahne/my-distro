# Graphics: QEMU's standard VGA (bochs) and virtio-gpu, plus a text console on it
CONFIG_DRM=y
CONFIG_DRM_BOCHS=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y

# Keyboard and mouse: /dev/input/event* for Xorg, USB tablet for a smooth mouse
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_MOUSEDEV=y
CONFIG_HID_SUPPORT=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_HID=y

# Booting from the ISO: initrd, UEFI, and the firmware's framebuffer as a
# fallback display ("safe graphics" boot entry)
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_FB_VESA=y
CONFIG_FB_EFI=y

# VirtualBox and VMware graphics
CONFIG_DRM_VMWGFX=y
CONFIG_DRM_VBOXVIDEO=y

# Hyper-V (Windows): graphics, keyboard, mouse, network
CONFIG_HYPERVISOR_GUEST=y
CONFIG_HYPERV=y
CONFIG_DRM_HYPERV=y
CONFIG_HYPERV_KEYBOARD=y
CONFIG_HID_HYPERV_MOUSE=y
CONFIG_HYPERV_NET=y

# PS/2 keyboard and mouse, older USB controllers (VirtualBox uses OHCI/EHCI)
CONFIG_SERIO_I8042=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_MOUSE_PS2=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_HCD_PCI=y
CONFIG_USB_UHCI_HCD=y

# Network cards of VirtualBox (Intel PRO/1000, PCnet) and VMware (vmxnet3)
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_INTEL=y
CONFIG_E1000=y
CONFIG_E1000E=y
CONFIG_NET_VENDOR_AMD=y
CONFIG_PCNET32=y
CONFIG_VMXNET3=y

# Needed by udev and our init
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_INOTIFY_USER=y
CONFIG_SIGNALFD=y
CONFIG_SERIAL_8250_CONSOLE=y

# File history (my-historyd) watches all file writes with fanotify
CONFIG_FANOTIFY=y

# Installing to and booting from a hard disk (my-install): disk controllers
# of VirtualBox (SATA AHCI), VMware (LSI SCSI, PVSCSI), Hyper-V and NVMe
# SSDs, and the FAT filesystem of the EFI system partition. ext4, IDE and
# virtio disks are already in the QEMU kernel config.
CONFIG_SATA_AHCI=y
CONFIG_BLK_DEV_NVME=y
CONFIG_FUSION=y
CONFIG_FUSION_SPI=y
CONFIG_VMWARE_PVSCSI=y
CONFIG_HYPERV_STORAGE=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# --- Real PCs and laptops ---------------------------------------------------
# Drivers that need firmware files are modules (=m): udev loads them when it
# finds the hardware, after the root filesystem with /lib/firmware is there.
# Built into the kernel (=y) they would start before that on an installed
# system and miss their firmware. The firmware: BR2_PACKAGE_LINUX_FIRMWARE_*
# in buildroot.fragment.
CONFIG_MODULES=y
CONFIG_FW_LOADER=y
# The firmware files are xz-compressed (post-build.sh): ~370 MB would
# otherwise sit in RAM on the live system
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_XZ=y

# Graphics cards: Intel (i915; xe for Arc and the newest laptops) and AMD
# (amdgpu; radeon for older cards). They give the screen's real resolution
# and more than one monitor. Without them (or with "safe graphics") the
# firmware's framebuffer is used. X draws with its modesetting driver.
CONFIG_DRM_I915=m
CONFIG_DRM_XE=m
CONFIG_DRM_AMDGPU=m
CONFIG_DRM_AMD_DC=y
CONFIG_DRM_RADEON=m

# Wired network: Realtek (r8169, in most PCs and laptops) and newer Intel
# (igb, igc)
CONFIG_NET_VENDOR_REALTEK=y
CONFIG_R8169=m
CONFIG_IGB=m
CONFIG_IGC=m

# Laptop touchpads and touchscreens: most are connected over I2C (HID over
# I2C), through the I2C controllers of Intel (LPSS) and AMD chipsets, with
# GPIO pins for their interrupts
CONFIG_I2C=y
CONFIG_I2C_HID_ACPI=m
CONFIG_HID_MULTITOUCH=m
CONFIG_I2C_DESIGNWARE_CORE=y
CONFIG_I2C_DESIGNWARE_PLATFORM=y
CONFIG_I2C_DESIGNWARE_PCI=y
CONFIG_MFD_INTEL_LPSS_ACPI=y
CONFIG_MFD_INTEL_LPSS_PCI=y
CONFIG_GPIOLIB=y
CONFIG_PINCTRL=y
CONFIG_PINCTRL_AMD=y
CONFIG_PINCTRL_INTEL=y
CONFIG_PINCTRL_SUNRISEPOINT=y
CONFIG_PINCTRL_CANNONLAKE=y
CONFIG_PINCTRL_ICELAKE=y
CONFIG_PINCTRL_TIGERLAKE=y
CONFIG_PINCTRL_ALDERLAKE=y
CONFIG_PINCTRL_METEORLAKE=y

# Wi-Fi: the 802.11 core (cfg80211, mac80211) and the drivers of the common
# laptop chips and USB Wi-Fi sticks. All modules, because they need firmware.
# /usr/lib/my-distro/wifi-start starts wpa_supplicant when one appears.
CONFIG_WLAN=y
CONFIG_RFKILL=y
CONFIG_CFG80211=m
# /proc/net/wireless: the taskbar reads the signal strength from it
CONFIG_CFG80211_WEXT=y
CONFIG_MAC80211=m
# Intel (most laptops)
CONFIG_WLAN_VENDOR_INTEL=y
CONFIG_IWLWIFI=m
CONFIG_IWLDVM=m
CONFIG_IWLMVM=m
CONFIG_IWLMLD=m
# Qualcomm Atheros
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_ATH9K=m
CONFIG_ATH9K_HTC=m
CONFIG_ATH10K=m
CONFIG_ATH10K_PCI=m
CONFIG_ATH11K=m
CONFIG_ATH11K_PCI=m
CONFIG_ATH12K=m
# MediaTek (also many USB sticks)
CONFIG_WLAN_VENDOR_MEDIATEK=y
CONFIG_MT7601U=m
CONFIG_MT7921E=m
CONFIG_MT7921U=m
CONFIG_MT7925E=m
CONFIG_MT7925U=m
# Realtek (cheap laptops, most USB sticks)
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_RTL8XXXU=m
CONFIG_RTW88=m
CONFIG_RTW88_8822BE=m
CONFIG_RTW88_8822CE=m
CONFIG_RTW88_8821CE=m
CONFIG_RTW88_8723DE=m
CONFIG_RTW88_8822BU=m
CONFIG_RTW88_8821CU=m
CONFIG_RTW89=m
CONFIG_RTW89_8852AE=m
CONFIG_RTW89_8852BE=m
CONFIG_RTW89_8852CE=m
CONFIG_RTW89_8922AE=m
# Broadcom (older laptops, MacBooks)
CONFIG_WLAN_VENDOR_BROADCOM=y
CONFIG_BRCMFMAC=m
CONFIG_BRCMFMAC_PCIE=y
CONFIG_BRCMFMAC_USB=y
# Virtual Wi-Fi radios for testing without Wi-Fi hardware (only when loaded
# by hand: modprobe mac80211_hwsim radios=2)
CONFIG_MAC80211_HWSIM=m

# --- 0.9.2 -------------------------------------------------------------------

# USB sticks, SD cards and disks from Windows and Macs: exFAT (most sticks
# over 32 GB), NTFS (Windows disks, read and write), CDs/DVDs (ISO 9660 with
# Joliet names, UDF) and UTF-8 file names on FAT. /usr/lib/my-distro/automount
# mounts them when they are plugged in.
CONFIG_EXFAT_FS=y
CONFIG_NTFS3_FS=y
CONFIG_ISO9660_FS=y
CONFIG_JOLIET=y
CONFIG_UDF_FS=y
CONFIG_NLS_UTF8=y

# Firewall: netfilter with nftables (rules in /etc/nftables.conf, loaded by
# /etc/init.d/S35firewall). conntrack remembers connections we started, so
# their replies get in while everything else from outside is dropped.
CONFIG_NETFILTER=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_CT=y
CONFIG_NFT_LOG=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_REJECT_INET=y

# Sound: the codec chips behind Intel HD Audio (Realtek in most PCs and
# laptops, Conexant, Cirrus, IDT, VIA, Analog Devices) and the sound over
# HDMI/DisplayPort. Built in (=y) like HD Audio itself, so they are there
# when it looks for them. Realtek, Cirrus and HDMI are groups: switching
# the group on brings all its chips (ALC269, ALC662, CS8409, Intel HDMI, ...).
# USB headsets and sound cards as a module.
CONFIG_SND_HDA_CODEC_REALTEK=y
CONFIG_SND_HDA_CODEC_CIRRUS=y
CONFIG_SND_HDA_CODEC_HDMI=y
CONFIG_SND_HDA_CODEC_CONEXANT=y
CONFIG_SND_HDA_CODEC_SIGMATEL=y
CONFIG_SND_HDA_CODEC_VIA=y
CONFIG_SND_HDA_CODEC_ANALOG=y
CONFIG_SND_USB_AUDIO=m

# The hardware clock: S48time writes the time from the internet into it, so
# it is right at the next start even without a network.
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_CMOS=y
