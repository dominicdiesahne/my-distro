# Graphics: QEMU's standard VGA (bochs) and virtio-gpu, plus a text console on it
CONFIG_DRM=y
CONFIG_DRM_BOCHS=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y

# Keyboard and mouse: /dev/input/event* for Xorg, USB tablet for a smooth mouse
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_MOUSEDEV=y
CONFIG_HID_SUPPORT=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_HID=y

# Booting from the ISO: initrd, UEFI, and the firmware's framebuffer as a
# fallback display ("safe graphics" boot entry)
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_FB_VESA=y
CONFIG_FB_EFI=y

# VirtualBox and VMware graphics
CONFIG_DRM_VMWGFX=y
CONFIG_DRM_VBOXVIDEO=y

# Hyper-V (Windows): graphics, keyboard, mouse, network
CONFIG_HYPERVISOR_GUEST=y
CONFIG_HYPERV=y
CONFIG_DRM_HYPERV=y
CONFIG_HYPERV_KEYBOARD=y
CONFIG_HID_HYPERV_MOUSE=y
CONFIG_HYPERV_NET=y

# PS/2 keyboard and mouse, older USB controllers (VirtualBox uses OHCI/EHCI)
CONFIG_SERIO_I8042=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_MOUSE_PS2=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_HCD_PCI=y
CONFIG_USB_UHCI_HCD=y

# Network cards of VirtualBox (Intel PRO/1000, PCnet) and VMware (vmxnet3)
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_INTEL=y
CONFIG_E1000=y
CONFIG_E1000E=y
CONFIG_NET_VENDOR_AMD=y
CONFIG_PCNET32=y
CONFIG_VMXNET3=y

# Needed by udev and our init
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_INOTIFY_USER=y
CONFIG_SIGNALFD=y
CONFIG_SERIAL_8250_CONSOLE=y

# File history (my-historyd) watches all file writes with fanotify
CONFIG_FANOTIFY=y
