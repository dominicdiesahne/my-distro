# Extra programs for the package manager (my-pkg, the Software app). NOT part
# of the image: `make packages` builds them on top of buildroot.fragment in
# the same build tree and packs each one (and each library they need that
# the image doesn't have) as its own package. desktop/packages.catalog has
# their names, categories and Start menu entries.
#
# A program may bring new libraries, but must not change an option of a
# package that is in the image (it would not be rebuilt, and installed
# systems have the image's version): `make packages` stops if one does.

# --- Office and documents ------------------------------------------------------
BR2_PACKAGE_MUPDF=y
BR2_PACKAGE_GNUPLOT=y

# --- Graphics ------------------------------------------------------------------
# (feh needs imlib2's JPEG loader, so that is in the image: buildroot.fragment)
BR2_PACKAGE_FEH=y
BR2_PACKAGE_IMAGEMAGICK=y

# --- Internet ------------------------------------------------------------------
BR2_PACKAGE_DILLO=y
BR2_PACKAGE_LYNX=y
BR2_PACKAGE_IRSSI=y
BR2_PACKAGE_OPENSSH=y
BR2_PACKAGE_OPENSSH_CLIENT=y
# no SSH server: it would need its own user, host keys and a start script
# BR2_PACKAGE_OPENSSH_SERVER is not set
BR2_PACKAGE_OPENSSH_KEY_UTILS=y

# --- Programming ---------------------------------------------------------------
BR2_PACKAGE_VIM=y
# Node.js (0.9.7): it builds V8, which alone takes hours on the build
# machine. It runs parts of its build in QEMU and with the build machine's
# Python; make packages rebuilds those build tools by itself.
BR2_PACKAGE_NODEJS=y
BR2_PACKAGE_HOST_PYTHON3_BZIP2=y
BR2_PACKAGE_HOST_PYTHON3_SSL=y
BR2_PACKAGE_HOST_QEMU_LINUX_USER_MODE=y
# A C compiler on my-distro itself (0.9.7): the Tiny C Compiler with the C
# library's headers (desktop/package/tinycc). Buildroot has no GCC for the
# target.
BR2_PACKAGE_TINYCC=y
BR2_PACKAGE_RUBY=y
# PHP: the php command, with HTTPS, SQLite, JSON and UTF-8 strings
BR2_PACKAGE_PHP=y
BR2_PACKAGE_PHP_SAPI_CLI=y
# BR2_PACKAGE_PHP_SAPI_CGI is not set
BR2_PACKAGE_PHP_EXT_OPENSSL=y
BR2_PACKAGE_PHP_EXT_CURL=y
BR2_PACKAGE_PHP_EXT_SQLITE=y
BR2_PACKAGE_PHP_EXT_PDO=y
BR2_PACKAGE_PHP_EXT_PDO_SQLITE=y
BR2_PACKAGE_PHP_EXT_MBSTRING=y
BR2_PACKAGE_PERL=y
BR2_PACKAGE_JQ=y

# --- Containers (0.9.7) -----------------------------------------------------------
# Docker: the engine (dockerd), containerd and runc, and the docker command.
# The kernel options are in the image's kernel (linux-gui.fragment), the
# start script in the image (/etc/init.d/S60docker, starts dockerd only
# when it is installed), cgroups v2 are mounted by S30cgroupfs2 from
# cgroupfs-v2-mount. docker-init (tini) for docker run --init.
BR2_PACKAGE_DOCKER_ENGINE=y
BR2_PACKAGE_DOCKER_CLI=y
BR2_PACKAGE_DOCKER_ENGINE_DOCKER_INIT_TINI=y
# iptables in its nftables variant (iptables-nft): the image's firewall is
# nftables too
BR2_PACKAGE_IPTABLES_NFTABLES=y
BR2_PACKAGE_IPTABLES_NFTABLES_DEFAULT=y

# --- Security (0.9.7) ---------------------------------------------------------------
# ClamAV, the virus scanner: clamscan and freshclam (signature updates);
# my-scan (in the image) is its window in a terminal
BR2_PACKAGE_CLAMAV=y

# --- Sharing (0.9.7) ----------------------------------------------------------------
# Samba: shares a folder and the printers with Windows, Macs and Linux. The
# Sharing window (my-sharing) sets it up and offers to install it.
BR2_PACKAGE_SAMBA4=y

# --- Terminal tools ------------------------------------------------------------
BR2_PACKAGE_TMUX=y
BR2_PACKAGE_NCDU=y
BR2_PACKAGE_P7ZIP=y
BR2_PACKAGE_ZIP=y
# bash and zsh are only offered when BusyBox's own shell may have company
# (this only shows them in the config; BusyBox itself doesn't change)
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_BASH=y
BR2_PACKAGE_ZSH=y
BR2_PACKAGE_NEOFETCH=y

# --- Games ---------------------------------------------------------------------
# The SDL 1.2 games draw into an X window (SDL's X11 video), not the console
BR2_PACKAGE_SDL=y
BR2_PACKAGE_SDL_X11=y
# BR2_PACKAGE_SDL_FBCON is not set
BR2_PACKAGE_LBREAKOUT2=y
BR2_PACKAGE_LBREAKOUT2_AUDIO=y
BR2_PACKAGE_LTRIS=y
BR2_PACKAGE_LTRIS_AUDIO=y
BR2_PACKAGE_PRBOOM=y
BR2_PACKAGE_DOOM_WAD=y
BR2_PACKAGE_OPENTYRIAN=y
BR2_PACKAGE_SL=y

