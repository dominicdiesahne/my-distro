#!/bin/sh
# my-distro xterm wrapper (1.4.0), installed as /usr/bin/xterm by
# desktop/post-build.sh; the real xterm is /usr/libexec/xterm.
#
# While the screen reader (my-reader) runs, the program in the terminal
# runs through my-term, which hands what it writes to the reader (xterm
# itself has no accessibility): "-e PROGRAM ARGS" becomes
# "-e my-term PROGRAM ARGS", and without -e the shell runs as
# "-e my-term". Otherwise xterm starts exactly as it is.
X=/usr/libexec/xterm
rt=${XDG_RUNTIME_DIR:-/nonexistent}
pid=$(cat "$rt/my-reader.pid" 2>/dev/null)
if [ -n "$pid" ] && [ -p "$rt/my-reader.say" ] && kill -0 "$pid" 2>/dev/null; then
	found=0
	for a; do
		shift
		if [ "$found" = 0 ] && [ "$a" = -e ]; then
			set -- "$@" -e /usr/bin/my-term
			found=1
		else
			set -- "$@" "$a"
		fi
	done
	[ "$found" = 1 ] || set -- "$@" -e /usr/bin/my-term
fi
exec "$X" "$@"
