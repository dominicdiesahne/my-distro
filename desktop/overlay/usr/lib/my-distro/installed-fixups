#!/bin/sh
# installed-fixups ROOT: turns a copy of the live system into an installed
# system. my-install runs it on the new disk; my-update runs it on / after
# every update, because the update brings the live system's files again.
R="${1:?usage: installed-fixups ROOT}"

# The installer is not needed on an installed system.
rm -f "$R/usr/share/applications/my-install.desktop" \
      "$R/root/Desktop/my-install.desktop" \
      "$R/etc/skel/Desktop/my-install.desktop" \
      "$R"/home/*/Desktop/my-install.desktop
sed -i '/my-install/d' "$R/etc/my-panel/menu"

# The welcome text talks about the live system.
for f in "$R/root/Documents/welcome.txt" "$R/etc/skel/Documents/welcome.txt" \
         "$R"/home/*/Documents/welcome.txt; do
	[ -f "$f" ] || continue
	sed -i -e 's/^Everything runs from RAM.*/This system is installed on a disk: your changes are kept./' \
	       -e '/Install to disk/d' "$f"
done
# Every normal user may choose Wi-Fi networks (group netdev, systems before
# 0.9 didn't add them), play sound (group audio, before 0.9.2), use the
# webcam (group video, before 0.9.4) and add printers (group lpadmin, before
# 0.9.5; its number comes from the new version's group file).
G="$R/etc/group"
grep -q '^netdev:' "$G" || echo 'netdev:x:82:' >>"$G"
grep -q '^audio:' "$G" || echo 'audio:x:29:' >>"$G"
grep -q '^video:' "$G" || echo 'video:x:28:' >>"$G"
# The system's own users and groups that a new version brings (0.9.5: lp
# and lpadmin for printing, avahi, ...): the user files are kept by updates,
# so add the missing ones from the new version's fresh copy.
F="$R/usr/share/my-distro/factory/etc"
if [ -f "$F/passwd" ]; then
	sys=$(awk -F: '$3 < 1000 { printf "%s ", $1 }' "$F/passwd")
	for f in passwd group shadow; do
		[ -f "$F/$f" ] && [ -f "$R/etc/$f" ] || continue
		awk -F: -v f="$f" -v sys=" $sys" 'NR == FNR { have[$1] = 1; next }
			!($1 in have) && (f == "group" ? $3 < 1000 : index(sys, " " $1 " ")) { print }' \
			"$R/etc/$f" "$F/$f" >>"$R/etc/$f"
	done
fi
for u in $(awk -F: '$3 >= 1000 && $3 < 60000 { print $1 }' "$R/etc/passwd"); do
	for grp in netdev audio video lpadmin; do
		awk -F: -v OFS=: -v u="$u" -v g="$grp" '
			$1 == g {
				n = split($4, m, ","); found = 0
				for (i = 1; i <= n; i++) if (m[i] == u) found = 1
				if (!found) $4 = ($4 == "" ? u : $4 "," u)
			}
			{ print }' "$G" >"$G.new" && mv "$G.new" "$G"
	done
done
chmod 644 "$G"

# The boot menu of systems installed before 0.9.4 has no recovery mode yet:
# add it, with the same kernel line as the first entry
B="$R/boot/grub/grub.cfg"
if [ -f "$B" ] && ! grep -q my-recovery "$B"; then
	line=$(grep -m 1 '^[[:space:]]*linux /boot/bzImage' "$B" | sed -e 's/^[[:space:]]*//' -e 's/ quiet$//')
	if [ -n "$line" ]; then
		printf '\n# Text console only, no desktop: to undo an update or reset the system\nmenuentry "my-distro (recovery mode)" {\n\t%s my-recovery\n}\n' "$line" >>"$B"
	fi
fi

# Encrypted systems (my-install, "Encrypt the disk"): GRUB starts the kernel
# from the EFI partition, so the kernel this system now has goes there, with
# a new initramfs (only does something when /etc/my-distro/crypt exists)
if [ -f "$R/etc/my-distro/crypt" ] && [ -x "$R/usr/sbin/my-mkinitramfs" ]; then
	"$R/usr/sbin/my-mkinitramfs" "$R" || echo "installed-fixups: my-mkinitramfs failed" >&2
fi

# Hibernate in the Start menu when there is a swap file for it (my-install
# makes one from 0.9.6 on) and the kernel knows where it is: resume= in the
# boot menu, or the initramfs of an encrypted system tells it
M="$R/etc/my-panel/menu"
if [ -f "$R/swapfile" ] && ! grep -q '^Hibernate|' "$M" &&
   { [ -f "$R/etc/my-distro/crypt" ] || grep -qs ' resume=' "$R/boot/grub/grub.cfg"; }; then
	sed -i '/^Suspend|/a\
Hibernate|my-hibernate|media-floppy' "$M"
fi

# --- Desktop sessions from older versions ----------------------------------------
# Home folders are never replaced by an update, so the session files there
# (copied from /etc/skel when the account was made) are still the old ones.
# Add what newer versions need to them, unless it is there already (also when
# you changed the files yourself): the session D-Bus in ~/.xinitrc (0.9.2),
# the keyboard shortcuts of each version, and (0.9.3) the autostart: the
# desktop's own parts now start from /usr/lib/my-distro/autostart, which
# updates keep current, so the user's file only keeps their own programs.
for h in "$R/root" "$R"/home/*; do
	[ -d "$h" ] || continue
	x="$h/.xinitrc"
	if [ -f "$x" ] && ! grep -q dbus-launch "$x" && grep -q '^exec openbox' "$x"; then
		sed -i '/^exec openbox/i\
# The session D-Bus (notifications); added by the 0.9.2 update\
if [ -z "$DBUS_SESSION_BUS_ADDRESS" ] && command -v dbus-launch >/dev/null; then\
	eval "$(dbus-launch --sh-syntax --exit-with-session)"\
fi\
' "$x"
	fi
	# 0.9.6: the session's language and proxy (Settings app)
	if [ -f "$x" ] && ! grep -q session-env "$x" && grep -q '^export LANG=' "$x"; then
		sed -i '/^export LANG=/a\
# Your language and proxy (Settings app); added by the 0.9.6 update\
. /usr/lib/my-distro/session-env' "$x"
	fi
	a="$h/.config/openbox/autostart"
	if [ -f "$a" ] && ! grep -q '/usr/lib/my-distro/autostart' "$a"; then
		# the lines that start the desktop's parts go; the rest stays
		sed -i -E '/^[[:space:]]*(my-settings --apply|my-notifyd|my-panel|my-indexd|my-update watch|pcmanfm --desktop)([[:space:]&#]|$)/d' "$a"
		sed -i '1a\
\
# The desktop'"'"'s own parts: taskbar, notifications, screen lock, ...\
# (/usr/lib/my-distro/autostart, kept up to date by system updates).\
. /usr/lib/my-distro/autostart' "$a"
	fi
	rc="$h/.config/openbox/rc.xml"
	if [ -f "$rc" ]; then
		# each version's shortcuts, unless that version's marker is there
		for keys in "$R"/usr/share/my-distro/openbox-keys-*.xml; do
			[ -f "$keys" ] || continue
			mark=$(head -n 1 "$keys")
			grep -qF "$mark" "$rc" || sed -i "/<chainQuitKey>/r $keys" "$rc"
		done
		# 0.9.2's sleep key: now locks the screen first
		sed -i 's|<command>my-power suspend</command>|<command>my-suspend</command>|' "$rc"
	fi
done
exit 0
