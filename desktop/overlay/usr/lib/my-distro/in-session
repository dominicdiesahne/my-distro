#!/bin/sh
# in-session PROGRAM [ARGS]: runs a program on the desktop of whoever is
# logged in, as that user. For programs that run as root without a desktop
# of their own: the lid daemon (my-lock) and automount (via notify-session).
# Exits 1 when nobody is logged in.
#
# The desktop's address (DISPLAY) and its session D-Bus (for notifications)
# are in the environment of the user's window manager (.xinitrc starts the
# bus); read them from there.
for p in /proc/[0-9]*; do
	[ "$(cat "$p/comm" 2>/dev/null)" = openbox ] || continue
	uid=$(awk '/^Uid:/ { print $2; exit }' "$p/status")
	user=$(awk -F: -v u="$uid" '$3 == u { print $1; exit }' /etc/passwd)
	env=$(tr '\0' '\n' <"$p/environ")
	bus=$(echo "$env" | sed -n 's/^DBUS_SESSION_BUS_ADDRESS=//p')
	display=$(echo "$env" | sed -n 's/^DISPLAY=//p')
	home=$(echo "$env" | sed -n 's/^HOME=//p')
	[ -n "$user" ] && [ -n "$display" ] || continue
	export DISPLAY="$display" DBUS_SESSION_BUS_ADDRESS="$bus" HOME="$home"
	if [ "$uid" = 0 ]; then
		"$@"
	else
		# "--": BusyBox's su would read the program's options as its own
		su -s /bin/sh -c 'exec "$@"' -- "$user" in-session "$@"
	fi
	exit $?
done
exit 1
