[Desktop Entry]
Type=Action
Name=Eject
Name[de]=Auswerfen
Tooltip=Eject (safely remove)
Icon=media-eject
Profiles=media;

# Only for the folders of USB sticks in /media. Careful: libfm (2016)
# crashes at start with "Folders=/media;"; "/media/*" works.
[X-Action-Profile media]
Name=Eject
Name[de]=Auswerfen
MimeTypes=inode/directory;
SelectionCount==1
Folders=/media/*;
Exec=my-eject %f
