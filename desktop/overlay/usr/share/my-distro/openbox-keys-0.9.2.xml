  <!-- my-distro 0.9.2: screenshots, volume, sleep -->
  <keybind key="Print"><action name="Execute"><command>my-screenshot</command></action></keybind>
  <keybind key="A-Print"><action name="Execute"><command>my-screenshot --window</command></action></keybind>
  <keybind key="S-Print"><action name="Execute"><command>my-screenshot --area</command></action></keybind>
  <keybind key="XF86AudioRaiseVolume"><action name="Execute"><command>my-volume up</command></action></keybind>
  <keybind key="XF86AudioLowerVolume"><action name="Execute"><command>my-volume down</command></action></keybind>
  <keybind key="XF86AudioMute"><action name="Execute"><command>my-volume mute</command></action></keybind>
  <keybind key="XF86Sleep"><action name="Execute"><command>my-power suspend</command></action></keybind>
