#!/bin/sh
# my-subids (1.0.0): subordinate user and group IDs for every user, so
# podman (a Software app package) can run containers without root. Inside a
# rootless container root and the other users are these IDs of the user
# outside; the setuid newuidmap and newgidmap (shadow) only hand out what
# /etc/subuid and /etc/subgid allow.
#
# Every normal user (uid 1000-59999) gets 65536 IDs, chosen by the uid so
# they never overlap and stay the same: uid 1000 from 100000, 1001 from
# 165536, ... (59999 ends below 2^32). Lines that are there stay as they
# are; lines of users that no longer exist go.
#
# Run as root at every start (/etc/init.d/S31containers) and by my-setup
# when it adds or removes a user. Updates keep both files (my-update), the
# factory reset removes them (they are made again at the next start).
[ "$(id -u)" = 0 ] || { echo "my-subids: run as root" >&2; exit 1; }
umask 022
for f in /etc/subuid /etc/subgid; do
	[ -f "$f" ] || : >"$f"
	: >"$f.new"
	awk -F: -v out="$f.new" '
		NR == FNR {
			if ($1 != "") user[$1] = 1
			if ($3 >= 1000 && $3 < 60000) uid[$1] = $3
			next
		}
		$1 == "" { next }
		($1 in user) || $1 ~ /^[0-9]+$/ { print >> out; have[$1] = 1 }
		END {
			for (u in uid)
				if (!(u in have))
					printf "%s:%.0f:65536\n", u, 100000 + (uid[u] - 1000) * 65536 >> out
		}' /etc/passwd "$f" || { rm -f "$f.new"; exit 1; }
	if cmp -s "$f" "$f.new"; then
		rm -f "$f.new"
	else
		chmod 644 "$f.new"
		mv "$f.new" "$f"
	fi
done

# 1.4.0: a control group of their own for every user, for limits of their
# rootless containers (podman run --memory 512m, --cpus 2, --pids-limit).
# Without systemd nobody else hands one out: /sys/fs/cgroup/my-users/UID
# and its children session (my-login puts the desktop session there:
# cgroup v2 moves a process only within a group its user owns) and
# containers belong to the user (the directories and
# cgroup.procs, cgroup.subtree_control, cgroup.threads: cgroup v2's
# delegation); the cpu, memory, io and pids controllers are switched on
# down to there. Podman puts each container into containers/libpod-ID
# (desktop/patches/podman). Groups of users that are gone are removed when
# they are empty.
CG=/sys/fs/cgroup
if grep -q " $CG cgroup2 " /proc/mounts; then
	ctl=$(for c in cpu memory io pids; do
		grep -qw "$c" "$CG/cgroup.controllers" 2>/dev/null && printf '+%s ' "$c"
	done)
	mkdir -p "$CG/my-users"
	for c in $ctl; do
		echo "$c" >"$CG/cgroup.subtree_control" 2>/dev/null
		echo "$c" >"$CG/my-users/cgroup.subtree_control" 2>/dev/null
	done
	awk -F: '$3 >= 1000 && $3 < 60000 { print $3 }' /etc/passwd | while read -r uid; do
		for d in "$CG/my-users/$uid" "$CG/my-users/$uid/session" "$CG/my-users/$uid/containers"; do
			mkdir -p "$d" || continue
			for c in $ctl; do
				[ "$d" = "$CG/my-users/$uid" ] && echo "$c" >"$d/cgroup.subtree_control" 2>/dev/null
			done
			chown "$uid" "$d" "$d/cgroup.procs" "$d/cgroup.subtree_control" "$d/cgroup.threads"
		done
	done
	for d in "$CG"/my-users/*/; do
		uid=$(basename "$d")
		awk -F: -v u="$uid" '$3 == u { f = 1 } END { exit !f }' /etc/passwd ||
			{ rmdir "$d/containers" "$d/session" "$d" 2>/dev/null; }
	done
fi
exit 0
