#!/bin/sh
# Sound to and from Bluetooth headphones, speakers and headsets: bluez-alsa's
# daemon. It registers with bluetoothd (S40bluetoothd) and turns every
# connected audio device into an ALSA sound device ("bluealsa"), so programs
# can play there without a sound server. my-bluetooth --watch makes it the
# default output while it is connected.
#   a2dp-source   music to headphones and speakers
#   hfp-ag/hsp-ag headsets with a microphone (phone-call quality)
# Log: /var/log/bluealsa.log
PIDFILE=/run/bluealsa.pid

case "$1" in
start)
	# bluez-alsa 4.2 renamed its daemon from bluealsa to bluealsad
	D=/usr/bin/bluealsad
	[ -x "$D" ] || D=/usr/bin/bluealsa
	[ -x "$D" ] || exit 0
	printf "Starting Bluetooth sound: "
	log=/var/log/bluealsa.log
	[ -d /var/log ] || log=/dev/null       # this early, /var/log can be missing
	/usr/bin/my-keepalive "$D" -p a2dp-source -p hfp-ag -p hsp-ag \
		</dev/null >"$log" 2>&1 &
	echo $! >$PIDFILE
	echo "OK"
	;;
stop)
	[ -f $PIDFILE ] && kill "$(cat $PIDFILE)" 2>/dev/null
	killall bluealsad bluealsa 2>/dev/null
	rm -f $PIDFILE
	;;
*)
	echo "Usage: $0 {start|stop}"
	exit 1
	;;
esac
