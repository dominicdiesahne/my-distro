#!/bin/sh
# Starts my-historyd, which saves a version of every changed file.
# Log: /var/log/my-history.log

case "$1" in
start)
	printf "Starting file history: "
	/usr/sbin/my-historyd </dev/null >/var/log/my-history.log 2>&1 &
	echo "OK"
	;;
stop)
	printf "Stopping file history: "
	killall my-historyd 2>/dev/null
	echo "OK"
	;;
*)
	echo "Usage: $0 {start|stop}"
	exit 1
	;;
esac
