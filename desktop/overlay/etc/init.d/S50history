#!/bin/sh
# Starts my-historyd, which saves a version of every changed file. If it
# crashes, my-keepalive starts it again.
# Log: /var/log/my-history.log
PIDFILE=/run/my-historyd.keepalive

case "$1" in
start)
	# Recovery mode (boot menu): only what is needed to repair the system
	grep -qw my-recovery /proc/cmdline && exit 0
	printf "Starting file history: "
	/usr/bin/my-keepalive -a /usr/sbin/my-historyd </dev/null >/var/log/my-history.log 2>&1 &
	echo $! > $PIDFILE
	echo "OK"
	;;
stop)
	printf "Stopping file history: "
	[ -f $PIDFILE ] && kill "$(cat $PIDFILE)" 2>/dev/null
	rm -f $PIDFILE
	killall my-historyd 2>/dev/null
	echo "OK"
	;;
*)
	echo "Usage: $0 {start|stop}"
	exit 1
	;;
esac
