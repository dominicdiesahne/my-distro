# Started by Openbox once it is running (see ~/.xinitrc).
#
# First the desktop's own parts: taskbar, notifications, screen lock, ...
# (/usr/lib/my-distro/autostart, kept up to date by system updates).
. /usr/lib/my-distro/autostart

# Your own programs go below, each with "&" at the end.
xterm -geometry 90x24+150+50 &   # right of the desktop icons
