msgid "Write the address as \\\\SERVER\\SHARE or smb://SERVER/SHARE."
msgstr "Schreib die Adresse als \\\\SERVER\\FREIGABE oder smb://SERVER/FREIGABE."

msgid "Write the proxy as NAME:PORT, e.g. proxy.example.com:3128."
msgstr "Schreib den Proxy als NAME:PORT, z. B. proxy.example.com:3128."

msgid "Write the times like 08:00 and 20:00."
msgstr "Schreib die Zeiten wie 08:00 und 20:00."

